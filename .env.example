# ---------- Required ----------
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/electron?retryWrites=true&w=majority
# At least 32 random characters. Also used to encrypt courier / gateway / tracking secrets stored in the database.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
# Optional: separate key for encrypting stored secrets (defaults to JWT_SECRET). Do NOT change it after saving credentials.
SECRETS_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------- First admin (npm run seed) ----------
SEED_ADMIN_NAME=ELECTRON Admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeThis-Strong-Password-123

# ---------- Cloudinary (image / 360° frames / .glb uploads from admin) ----------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---------- SSLCommerz (optional fallback: you can also add gateways in Admin → Payment) ----------
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_IS_LIVE=false
